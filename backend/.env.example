# Sequelize accepts a plain postgres:// URL (a postgresql+psycopg2:// URL is also
# auto-normalized for backwards compatibility).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fintech_agent
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
LLM_WRAPPER_URL=https://llm-wrapper-741152993481.asia-south1.run.app
LLM_WRAPPER_TOKEN=replace-with-api-token
BACKEND_CORS_ORIGINS=["http://localhost:3000"]
SEED_SAMPLE_DATA=true
EXPOSE_DEBUG_ENDPOINTS=false
PORT=8000
